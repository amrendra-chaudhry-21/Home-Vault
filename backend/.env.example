# HomeVault (Home Memory) Environment Configuration
NODE_ENV=development
PORT=5001
MONGODB_URI=mongodb://localhost:27017/home_memory_db

# Security & Authentication
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_chars_long_example
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_chars_long_example
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# CORS
CORS_ORIGINS=*

# Storage Configuration (local | s3)
UPLOAD_STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=public/uploads

# S3 Compatible Object Storage (Optional for Production)
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=ap-south-1
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
